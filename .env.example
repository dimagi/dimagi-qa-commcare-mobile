# Copy to .env and fill in. Never commit the real .env file.

# --- BrowserStack App Automate ---
BROWSERSTACK_USERNAME=
# "Access Key" on your BrowserStack account page. Same value used as
# BROWSERSTACK_PASSWORD in the commcare-android repo's Espresso CI job.
BROWSERSTACK_ACCESS_KEY=

# --- CommCareHQ (for flows that need a build marked Released / update settings changed) ---
HQ_BASE_URL=https://www.commcarehq.org
HQ_API_USERNAME=
HQ_API_PASSWORD=
HQ_DOMAIN=qateam

# --- Device under test credentials (mobile worker login used across most flows) ---
CC_TEST_USERNAME=test1
CC_TEST_PASSWORD=123
# Second mobile-worker used by a few Prompted Updates frequency tests
CC_TEST2_USERNAME=test2
CC_TEST2_PASSWORD=123

# --- Install flow credentials (Install 7/8 - separate from CC_TEST_* above) ---
HQ_MOBILE_WORKER_USERNAME=
HQ_MOBILE_WORKER_PASSWORD=
HQ_WEB_USER_EMAIL=
HQ_WEB_USER_PASSWORD=

# --- APK source ---
# GitHub release tag to pull from dimagi/commcare-android, e.g. commcare_2.63.4.
# Leave blank to use the latest release with a usable .apk asset.
COMMCARE_RELEASE_TAG=
