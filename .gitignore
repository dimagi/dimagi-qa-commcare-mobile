__pycache__/
*.pyc
.venv/
venv/

# Local secrets
.env

# Downloaded APKs and zipped flow bundles
apks/
*.apk
*.aab
flows.zip

# Exception: the ExternalApp Tests companion app - small (1.1MB), needed by
# CI (--other-app), and there's no HQ-hosted equivalent to fetch on demand
# the way resources/README.md's CCZs are - see flows/externalapp_tests/README.md.
!resources/Mobile API Testing App-release.apk

# Exception: a commcare-android build not yet published as a GitHub release
# (~41MB, committed anyway per direct user decision) - lets
# scripts/run_suite.py/run_appium_suite.py's --apk (and the CI workflow's
# apk_path input) test it directly instead of the normal
# latest-release/--release-tag download path.
!resources/app-commcare-release-Android16.apk

# BrowserStack / run artifacts
artifacts/
*.log

# Generated HTML reports - regenerate any of these via scripts/report_generator.py.
# history.json is the one exception: it's what the trend chart is drawn from,
# so it's tracked (see the maestro-browserstack.yml cache step for how it
# survives across CI runs too).
reports/*
!reports/history.json

# QA app CCZs - every app this repo tests installs via a dynamic HQ app
# code at run time (see resources/README.md), never a sideloaded local CCZ,
# so none of these are ever committed - download on demand (e.g. via
# scripts/fetch_large_ccz.py or HQClient.download_ccz) if you need one to
# inspect while writing/fixing a flow's selectors.
*.ccz
